# Copy to nexus.env (git-ignored) and fill in. Used by scripts/publish-nexus.sh / .ps1
# Docker registry address of your Nexus "docker (hosted)" repository:
#   connector port:    nexus.example.com:8083
#   path-based:        nexus.example.com/repository/docker-hosted
NEXUS_REGISTRY=
# Nexus user allowed to push (role with nx-repository-view-docker-<repo>-add/edit)
NEXUS_USER=
# Leave empty to be asked for it (recommended)
NEXUS_PASSWORD=
# Image name inside the repository
IMAGE_NAME=eve-war-bot
# Target CPU of the server (DigitalOcean droplets: linux/amd64)
PLATFORM=linux/amd64
